# Routing provider selection
# Valid options: "ors" (default) or "google"
ROUTING_PROVIDER=ors

# OpenRouteService credentials
# Required when ROUTING_PROVIDER is "ors"
ORS_API_KEY=
# Optional default country hint for Pelias geocoding (e.g. Australia)
ORS_COUNTRY=Australia

# Google Maps Platform credentials
# Required when ROUTING_PROVIDER is "google"
GOOGLE_MAPS_API_KEY=
# Optional region bias for Google geocoding fallbacks (two-letter code)
GOOGLE_MAPS_REGION=AU

# Shared application settings
# Path to the SQLite database backing CLI + dashboard workflows
ROUTES_DB=routes.db
# Override dashboard database path without touching CLI defaults
CORKYSOFT_DB=
