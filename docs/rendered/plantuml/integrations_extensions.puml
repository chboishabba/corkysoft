@startuml
title Corkysoft Integrations + Extensions
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180
package "Integrations + Extensions" {
  [corkysoft.api] as corkysoft_api
  [corkysoft.api_calls] as corkysoft_api_calls
  [corkysoft.api_kent] as corkysoft_api_kent
  [corkysoft.api_labor] as corkysoft_api_labor
  [corkysoft.api_operations] as corkysoft_api_operations
  [corkysoft.api_shared] as corkysoft_api_shared
  [corkysoft.call_ops] as corkysoft_call_ops
  [corkysoft.call_ops_actions] as corkysoft_call_ops_actions
  [corkysoft.call_ops_core] as corkysoft_call_ops_core
  [corkysoft.call_ops_transcripts] as corkysoft_call_ops_transcripts
  [corkysoft.call_ops_worker_time] as corkysoft_call_ops_worker_time
  [corkysoft.cost_model] as corkysoft_cost_model
  [corkysoft.importers] as corkysoft_importers
