  [corkysoft.mcp.server] as corkysoft_mcp_server
  [corkysoft.mcp.tools] as corkysoft_mcp_tools
  [corkysoft.src.dashboard] as corkysoft_src_dashboard
  [corkysoft.src.dashboard.app] as corkysoft_src_dashboard_app
  [corkysoft.src.dashboard.components] as corkysoft_src_dashboard_components
  [corkysoft.src.dashboard.data] as corkysoft_src_dashboard_data
  [corkysoft.src.dashboard.state] as corkysoft_src_dashboard_state
  [corkysoft.whisperx_adapter] as corkysoft_whisperx_adapter
}
corkysoft_api --> corkysoft_api_calls
corkysoft_api --> corkysoft_api_kent
corkysoft_api --> corkysoft_api_labor
corkysoft_api --> corkysoft_api_operations
corkysoft_api --> corkysoft_api_shared
corkysoft_api --> corkysoft_call_ops
corkysoft_api_calls --> corkysoft_api_shared
corkysoft_api_calls --> corkysoft_call_ops
corkysoft_api_calls --> corkysoft_whisperx_adapter
corkysoft_api_operations --> corkysoft_api_shared
corkysoft_call_ops --> corkysoft_call_ops_actions
corkysoft_call_ops --> corkysoft_call_ops_core
corkysoft_call_ops --> corkysoft_call_ops_transcripts
corkysoft_call_ops --> corkysoft_call_ops_worker_time
corkysoft_call_ops --> corkysoft_whisperx_adapter
corkysoft_call_ops_actions --> corkysoft_call_ops
corkysoft_call_ops_core --> corkysoft_call_ops
corkysoft_call_ops_transcripts --> corkysoft_call_ops
corkysoft_call_ops_worker_time --> corkysoft_call_ops
corkysoft_mcp___main__ --> corkysoft_mcp_bridge
corkysoft_mcp___main__ --> corkysoft_mcp_server
corkysoft_mcp_bridge --> corkysoft_mcp
corkysoft_mcp_registry --> corkysoft_mcp_contracts
corkysoft_mcp_registry --> corkysoft_mcp_tools
corkysoft_mcp_server --> corkysoft_mcp_contracts
corkysoft_mcp_server --> corkysoft_mcp_registry
corkysoft_mcp_tools --> corkysoft_mcp_contracts
[Analytics + Persistence] as external_analytics_persistence
corkysoft_api ..> external_analytics_persistence : api -> operations_diary\napi -> db\napi -> db_connection
corkysoft_call_ops ..> external_analytics_persistence : call_ops -> schema
corkysoft_mcp_tools ..> external_analytics_persistence : tools -> price_distribution\ntools -> operations_diary\ntools -> connection
corkysoft_api_calls ..> external_analytics_persistence : api_calls -> operations_diary\napi_calls -> db_connection
corkysoft_api_kent ..> external_analytics_persistence : api_kent -> db_connection\napi_kent -> kent_ams_import
corkysoft_api_labor ..> external_analytics_persistence : api_labor -> db\napi_labor -> db_connection\napi_labor -> labor_analytics
corkysoft_api_operations ..> external_analytics_persistence : api_operations -> inventory\napi_operations -> db_connection\napi_operations -> operations_assignment
[Quote + Routing Core] as external_quote_routing_core
corkysoft_call_ops ..> external_quote_routing_core : call_ops -> repo
corkysoft_cost_model ..> external_quote_routing_core : cost_model -> schema
@enduml
