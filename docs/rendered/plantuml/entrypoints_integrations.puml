@startuml
title Corkysoft Entrypoints
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180
package "Entrypoints" {
  [map_jobs.py] as map_jobs
  [profit_optimizer.py] as profit_optimizer
  [quick_quote.py] as quick_quote
  [routes_to_sqlite.py] as routes_to_sqlite
}
[Analytics + Persistence] as external_analytics_persistence
routes_to_sqlite ..> external_analytics_persistence : routes_to_sqlite -> routing_provider
quick_quote ..> external_analytics_persistence : quick_quote -> db
map_jobs ..> external_analytics_persistence : map_jobs -> routes_map
[Quote + Routing Core] as external_quote_routing_core
routes_to_sqlite ..> external_quote_routing_core : routes_to_sqlite -> au_address
quick_quote ..> external_quote_routing_core : quick_quote -> quote_service\nquick_quote -> repo\nquick_quote -> pricing
@enduml
